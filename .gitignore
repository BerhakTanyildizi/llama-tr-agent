# TRAINING OUTPUTS — GB-scale, reproducible
# =============================================================================
training/outputs/
*.gguf
*.safetensors
*.bin
checkpoint-*/

# =============================================================================
# GENERATED / RUN OUTPUTS — reproducible, not source
# =============================================================================
# Rebuilt by `python inference/grammar/generate_gbnf.py` from the tool registry.
# Committing it would let it drift away from the schemas it is derived from.
inference/grammar/tool_call.gbnf
# Per-run evaluation reports (`--out`). Any name, because the flag takes one:
# sonuc_V1.json, r.json, r_grammar.json ... The test set is .jsonl and unaffected.
eval/*.json


